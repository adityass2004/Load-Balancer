generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum Algorithm {
  ROUND_ROBIN
  LEAST_CONNECTIONS
  WEIGHTED_ROUND_ROBIN
  IP_HASH
  RANDOM
  PRIORITY
}

enum ServerHealth {
  HEALTHY
  UNHEALTHY
  UNKNOWN
}

// =========================
// PROJECT
// =========================

model Project {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String       @unique
  description String?
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  servers     Server[]
  settings    Settings?
  requestLogs RequestLog[]

  @@index([enabled])
  @@map("projects")
}

// =========================
// SERVER
// =========================

model Server {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           String?      @map("project_id") @db.Uuid
  project             Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  url                 String
  enabled             Boolean      @default(true)
  healthy             ServerHealth @default(UNKNOWN)
  weight              Int          @default(1)
  priority            Int          @default(0)
  requestsHandled     Int          @default(0) @map("requests_handled")
  activeRequests      Int          @default(0) @map("active_requests")
  lastHealthCheck     DateTime?    @map("last_health_check") @db.Timestamptz(6)
  averageResponseTime Float        @default(0) @map("average_response_time")
  failureCount        Int          @default(0) @map("failure_count")
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, url])
  @@index([enabled, healthy])
  @@index([priority])
  @@index([deletedAt])
  @@index([projectId])
  @@map("servers")
}

// =========================
// SETTINGS
// =========================

model Settings {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           String?   @unique @map("project_id") @db.Uuid
  project             Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  algorithm           Algorithm @default(ROUND_ROBIN)
  healthCheckInterval Int       @default(30) @map("health_check_interval")
  healthCheckTimeout  Int       @default(5) @map("health_check_timeout")
  maxFailures         Int       @default(3) @map("max_failures")
  autoRecovery        Boolean   @default(true) @map("auto_recovery")
  requestTimeout      Int       @default(10000) @map("request_timeout")
  maxRetries          Int       @default(3) @map("max_retries")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

// =========================
// HTTP METHOD ENUM
// =========================

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

// =========================
// REQUEST LOG
// =========================

model RequestLog {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String?    @map("project_id") @db.Uuid
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestId      String     @map("request_id") @db.Uuid
  method         HttpMethod
  route          String
  backendId      String?    @map("backend_id") @db.Uuid
  backendUrl     String?    @map("backend_url")
  statusCode     Int?       @map("status_code")
  responseTimeMs Int?       @map("response_time_ms")
  retryCount     Int        @default(0) @map("retry_count")
  errorMessage   String?    @map("error_message")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([requestId])
  @@index([backendId])
  @@index([statusCode])
  @@index([method])
  @@index([projectId])
  @@index([projectId, createdAt])
  @@map("request_logs")
}

// =========================
// ADMIN USER & ALLOWLIST
// =========================

enum AdminRole {
  OWNER
  ADMIN
}

model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  role      AdminRole
  addedBy   String?
  createdAt DateTime  @default(now())

  @@index([email])
}
