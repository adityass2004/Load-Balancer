# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/load_balancer"

# Application public base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cache configuration (milliseconds)
CACHE_REFRESH_INTERVAL=3000000

# Health monitoring (milliseconds)
HEALTH_CHECK_INTERVAL=600000

# Load balancer execution timeouts & retries
REQUEST_TIMEOUT=5000
MAX_RETRIES=3

# ==============================================================================
# Cron Endpoint Authentication (MEDIUM-03)
# ==============================================================================
# Secret token for triggering background health checks via GET /api/cron/health.
# Must be at least 16 characters. If missing or shorter than 16 chars, the endpoint
# fails closed (returns 401 Unauthorized for all requests). Never reuse AUTH_SECRET as CRON_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Schedulers (e.g. Google Cloud Scheduler, cron service) must send:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ==============================================================================
# Auth.js / NextAuth v5 Configuration (Google OAuth Only)
# ==============================================================================

# Auth.js signing/encryption secret (generate with: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth Web Application Client ID
AUTH_GOOGLE_ID=

# Google OAuth Web Application Client Secret
AUTH_GOOGLE_SECRET=

# Application base URL for OAuth callbacks
AUTH_URL=http://localhost:3000

# Additional allowed origins for Next.js Server Actions CSRF protection (HIGH-03).
# Comma-separated host[:port] values (e.g. "lb.example.com,admin.example.com").
# Note: AUTH_URL's host is added automatically. "localhost:3000" is included in dev only.
# Wildcard subdomains like "*.example.com" are supported.
APP_ALLOWED_ORIGINS=

# Email allowed to bootstrap the first OWNER account upon initial login
INITIAL_OWNER_EMAIL=

# ==============================================================================
# Redis & Distributed Rate Limiting (CRITICAL-03)
# ==============================================================================

# Redis connection string (TCP). Local development:
# docker run -d --name trackit-redis -p 6379:6379 redis:7
REDIS_URL=redis://localhost:6379

# Number of trusted reverse proxy hops in front of TrackIt.
# Must match the real architecture (e.g. 1 for Cloud Run/Cloudflare, 2 for Cloudflare -> ALB -> TrackIt).
TRUSTED_PROXY_HOPS=1

# Rate limiting scopes and limits (sliding window counter)
# Proxy route (app/api/[...path]/route.ts)
RATE_LIMIT_PROXY_IP_MAX=600
RATE_LIMIT_PROXY_WINDOW_SEC=60
RATE_LIMIT_PROXY_PROJECT_MAX=6000
RATE_LIMIT_PROXY_PROJECT_WINDOW_SEC=60

# Admin API (/api/admin/*)
RATE_LIMIT_ADMIN_IP_MAX=60
RATE_LIMIT_ADMIN_WINDOW_SEC=60

# Auth API (/api/auth/*)
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_AUTH_WINDOW_SEC=60

# Cron API (/api/cron/*) (MEDIUM-03)
RATE_LIMIT_CRON_IP_MAX=10
RATE_LIMIT_CRON_WINDOW_SEC=60

# Failure modes when Redis is unreachable ('open' | 'closed')
RATE_LIMIT_FAIL_MODE_PROXY=open
RATE_LIMIT_FAIL_MODE_ADMIN=closed
RATE_LIMIT_FAIL_MODE_AUTH=closed
RATE_LIMIT_FAIL_MODE_CRON=closed

# Fallback divisor for in-memory degraded mode when Redis is unreachable (positive integer)
RATE_LIMIT_FALLBACK_DIVISOR=1

# Redis circuit breaker during outages
RATE_LIMIT_REDIS_BREAKER_FAILURES=3
RATE_LIMIT_REDIS_BREAKER_COOLDOWN_SEC=10

# Multiplier applied to per-IP rate limit when client IP is unknown
RATE_LIMIT_UNKNOWN_IP_MULTIPLIER=5

# ==============================================================================
# Bounded & Streaming Request Bodies (CRITICAL-04)
# ==============================================================================

# Hard cap per request body in bytes (default 10 MB, max allowed 1 GB)
MAX_REQUEST_BODY_BYTES=10485760

# Idempotent bodies up to this size are buffered so retries can replay them (default 256 KB)
BODY_BUFFER_THRESHOLD_BYTES=262144

# Global cap on bytes buffered concurrently across all in-flight requests (default 32 MB)
BODY_BUFFER_BUDGET_BYTES=33554432

# ==============================================================================
# SSRF Protection (CRITICAL-05)
# ==============================================================================

# Comma-separated list of private CIDRs that backends are allowed to use.
# Example: BACKEND_ALLOWED_PRIVATE_CIDRS=10.20.0.0/16,10.21.5.0/24
#
# Rules:
#   - Entries MUST be valid CIDRs in CIDR notation (e.g. 10.20.0.0/16).
#   - Entries that overlap an always-blocked range (169.254.x.x, link-local,
#     multicast, documentation ranges, etc.) are rejected at startup with a
#     clear error.
#   - This variable can ONLY be set by the server operator in the environment
#     or secrets manager. It is NEVER settable through the API or dashboard.
#   - Default: empty (all private ranges blocked in production).
#   - Use case: set this to your VPC's backend CIDR(s) when your load balancer
#     targets private IPs inside a trusted VPC.
BACKEND_ALLOWED_PRIVATE_CIDRS=

# Allow loopback addresses (127.x.x.x, ::1, localhost) as backend URLs.
# MUST be false (or unset) in production — the app will refuse to start if
# this is true and NODE_ENV=production.
# Set to true ONLY for local development (e.g. when running test backends on
# localhost:4001-4003 via scripts/seed-test-project.ts).
#
# Usage in dev:
#   BACKEND_ALLOW_LOOPBACK=true npm run dev
#   BACKEND_ALLOW_LOOPBACK=true npx ts-node --esm scripts/seed-test-project.ts
#
BACKEND_ALLOW_LOOPBACK=false

# ==============================================================================
# Header Sanitization & Proxy Security (HIGH-04 & Loop Guard)
# ==============================================================================

# Whether to trust incoming X-Forwarded-Host header.
# Default: false (TrackIt sets X-Forwarded-Host from the incoming Host header only).
# Set to true only if behind a trusted upstream reverse proxy that guarantees X-Forwarded-Host.
TRUST_FORWARDED_HOST=false

# Maximum allowed proxy loop hops before returning 508 Loop Detected.
# TrackIt increments x-trackit-hop on each proxy forward.
# Default: 3 (positive integer).
PROXY_MAX_HOPS=3

# Socket connect timeout (ms) for upstream backends in forwarder and health checker.
# Unresponsive/dead backends will fail in ~2 seconds instead of waiting for full request timeout.
# Default: 2000 (positive integer in ms).
BACKEND_CONNECT_TIMEOUT_MS=2000

# ==============================================================================
# Asynchronous Request Logging (HIGH-01)
# ==============================================================================
# Proxy requests are logged to request_logs asynchronously via an in-memory
# queue that flushes in batches with createMany. Logging never blocks or delays
# a proxy response. If the DB is unreachable, entries queue up to the cap and
# are then dropped (counted). A circuit breaker pauses writes after repeated
# failures and probes once the cooldown expires.

# Hard cap on entries in the in-memory queue (positive integer, default 10000).
# When full, new entries are dropped. Each entry is ~500 bytes, so 10 000 ≈ 5 MB.
LOG_QUEUE_MAX_ENTRIES=10000

# Flush when this many entries are queued (positive integer, default 200).
# Must be <= LOG_QUEUE_MAX_ENTRIES.
LOG_BATCH_SIZE=200

# Also flush on this interval regardless of batch size (ms, default 1000).
LOG_FLUSH_INTERVAL_MS=1000

# Per-flush DB timeout (ms, default 5000). If a single createMany takes longer,
# it is treated as a failure and retried.
LOG_FLUSH_TIMEOUT_MS=5000

# Maximum time to spend flushing during graceful shutdown / SIGTERM (ms, default 5000).
# Depends on the Dockerfile fix (HIGH-02) to deliver SIGTERM to Node.
LOG_SHUTDOWN_FLUSH_MS=5000

# Retries for a failed batch before it is permanently dropped (default 3).
# Exponential backoff with jitter is used between retries.
LOG_MAX_RETRIES=3

# Fraction of successful (2xx/3xx) requests to log, 0..1 (default 1 = log all).
# Errors (4xx, 5xx) and infrastructure failures are ALWAYS logged regardless.
# Set to 0.1 to log ~10% of successful requests under high traffic.
LOG_SUCCESS_SAMPLE_RATE=1

# Circuit breaker consecutive failure threshold before pausing DB writes (default 5).
LOG_BREAKER_THRESHOLD=5

# Circuit breaker pause/cooldown duration in milliseconds before probing (ms, default 30000).
LOG_BREAKER_COOLDOWN_MS=30000

# ==============================================================================
# Health Probe & Monitoring Configuration (HIGH-06)
# ==============================================================================
# Public GET /api/{projectSlug} reads health exclusively from cache.
# Top-level stale flag set to true if any server check is older than this limit (sec, default 60).
HEALTH_STALE_AFTER_SEC=60

# Background health check per-probe HTTP request timeout (ms, default 5000).
HEALTH_PROBE_TIMEOUT_MS=5000

# Maximum concurrent backend health probes in background check cycles (default 10).
HEALTH_PROBE_CONCURRENCY=10

# ==============================================================================
# Retry Backoff & Jitter Configuration (MEDIUM-04)
# ==============================================================================
# Base initial delay before first retry attempt (ms, default 50).
RETRY_BASE_DELAY_MS=50

# Maximum per-attempt retry delay cap under full jitter (ms, default 300).
RETRY_MAX_DELAY_MS=300

# Maximum cumulative sleep budget allowed per request across retries (ms, default 2000).
RETRY_MAX_TOTAL_MS=2000



